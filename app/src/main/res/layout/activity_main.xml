<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="隐私协议"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="agreePrivacyClick"
            android:text="同意隐私协议（showUserAgree + onUserAgree）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="账号"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="loginClick"
            android:text="登录" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="logoutClick"
            android:text="登出" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userCenterClick"
            android:text="用户中心" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="realNameClick"
            android:text="实名认证" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="支付"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="payClick"
            android:text="支付 1 元（gravity_dock_product_1）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="事件上报"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="trackCustomClick"
            android:text="自定义事件 track" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="trackRegisterClick"
            android:text="注册事件 trackRegisterEvent" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="trackLoginClick"
            android:text="登录事件 trackLoginEvent" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="trackLogoutClick"
            android:text="登出事件 trackLogoutEvent" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="trackAdClick"
            android:text="广告事件组（load/show/click/play）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="用户属性"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userSetClick"
            android:text="user_set" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userSetOnceClick"
            android:text="user_setOnce" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userIncrementClick"
            android:text="user_increment" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userMaxClick"
            android:text="user_max" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userMinClick"
            android:text="user_min" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userAppendClick"
            android:text="user_append" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userUniqAppendClick"
            android:text="user_uniqAppend" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userUnsetClick"
            android:text="user_unset" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="userDeleteClick"
            android:text="user_delete" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="公共事件属性"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="setSuperPropertiesClick"
            android:text="设置公共事件属性" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="unsetSuperPropertiesClick"
            android:text="移除公共事件属性 channel" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="clearSuperPropertiesClick"
            android:text="清空公共事件属性" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="其他"
            android:textStyle="bold" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="flushClick"
            android:text="立即上报 flush" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="gameBeginClick"
            android:text="进入游戏 gameBegin" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="gameEndClick"
            android:text="退出游戏 gameEnd" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="showFloatWindowClick"
            android:text="展示浮标" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="hideFloatWindowClick"
            android:text="隐藏浮标" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="exitClick"
            android:text="退出应用 exitApp" />

    </LinearLayout>
</ScrollView>
